{
  "manifest_version": 3,
  "name": "ContextVault User Adapter",
  "version": "0.2.0",
  "description": "Fill approved ContextVault profile packages into AI sites where you are already logged in.",
  "permissions": ["activeTab", "storage", "clipboardWrite", "alarms", "tabs", "notifications"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://chatgpt.com/*", "https://chat.openai.com/*", "https://gemini.google.com/*", "https://claude.ai/*",
    "https://www.perplexity.ai/*", "https://perplexity.ai/*", "https://copilot.microsoft.com/*", "https://grok.com/*", "https://chat.mistral.ai/*", "https://poe.com/*",
    "https://chat.deepseek.com/*", "https://www.kimi.com/*", "https://kimi.com/*", "https://kimi.moonshot.cn/*",
    "https://www.qianwen.com/*", "https://qianwen.com/*", "https://tongyi.aliyun.com/*", "https://chat.qwen.ai/*",
    "https://www.doubao.com/*", "https://doubao.com/*", "https://yuanbao.tencent.com/*", "https://ai.tencent.com/*",
    "https://chatglm.cn/*", "https://www.chatglm.cn/*", "https://yiyan.baidu.com/*", "https://chat.baidu.com/*",
    "https://xinghuo.xfyun.cn/*", "https://www.tiangong.cn/*", "https://tiangong.cn/*", "https://hailuoai.com/*", "https://www.hailuoai.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "ContextVault",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://claude.ai/*",
        "https://www.perplexity.ai/*", "https://perplexity.ai/*", "https://copilot.microsoft.com/*", "https://grok.com/*", "https://chat.mistral.ai/*", "https://poe.com/*",
        "https://chat.deepseek.com/*", "https://www.kimi.com/*", "https://kimi.com/*", "https://kimi.moonshot.cn/*",
        "https://www.qianwen.com/*", "https://qianwen.com/*", "https://tongyi.aliyun.com/*", "https://chat.qwen.ai/*",
        "https://www.doubao.com/*", "https://doubao.com/*", "https://yuanbao.tencent.com/*", "https://ai.tencent.com/*",
        "https://chatglm.cn/*", "https://www.chatglm.cn/*", "https://yiyan.baidu.com/*", "https://chat.baidu.com/*",
        "https://xinghuo.xfyun.cn/*", "https://www.tiangong.cn/*", "https://tiangong.cn/*", "https://hailuoai.com/*", "https://www.hailuoai.com/*"
      ],
      "js": ["providers.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
