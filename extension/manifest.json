{
  "manifest_version": 3,
  "name": "ContextVault User Adapter",
  "version": "0.1.0",
  "description": "Fill approved ContextVault profile packages into AI sites where you are already logged in.",
  "permissions": ["activeTab", "storage", "clipboardWrite"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_title": "ContextVault",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://claude.ai/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
